# Copy this file to .env and fill in the values


# Database
DATABASE_URL=
DB_PASSWORD=
SQLALCHEMY_ECHO=false


# Auth / Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60



# Integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DISCORD_TOKEN=
DISCORD_WEBHOOK_URL=


# Default personal user
DEFAULT_USERNAME=sir
DEFAULT_USER_PASSWORD=
CREATE_DEFAULT_USER_ON_STARTUP=true

# CORS (JSON array of origins). Use ["*"] to allow all.
CORS_ORIGINS=["*"]